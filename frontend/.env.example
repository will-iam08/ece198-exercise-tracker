# Public configuration only. Vite inlines VITE_* values into the browser bundle,
# so never put passwords, account tokens, or device tokens in this file.
# Copy to .env.local to override. Everything here is optional.

# Where the dev/preview server forwards /api (the backend). Default shown.
# VITE_API_TARGET=http://127.0.0.1:3000

# Extra host names the dev/preview server may be opened on, for example a
# Cloudflare Tunnel domain. Comma-separated; a leading dot allows subdomains.
# VITE_ALLOWED_HOSTS=.trycloudflare.com

# Only when the website and the API are on different origins: the API origin
# the browser should call. Leave unset to call /api on the website's own address.
# VITE_API_ORIGIN=https://api.example.org
