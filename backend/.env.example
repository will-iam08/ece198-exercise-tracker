HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/ece198.sqlite
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Email bot (all optional). The address patients email, shown on their Messages tab:
# BOT_EMAIL_ADDRESS=ask@motiontrack.example.org
# Turns on POST /api/bot/inbound-email; use at least 16 random characters:
# BOT_WEBHOOK_SECRET=
# Read a mailbox over IMAP instead (only when host, user and password are all set):
# BOT_IMAP_HOST=imap.example.org
# BOT_IMAP_PORT=993
# BOT_IMAP_TLS=true
# BOT_IMAP_USER=ask@motiontrack.example.org
# BOT_IMAP_PASS=
# BOT_IMAP_MAILBOX=INBOX
# BOT_IMAP_POLL_SECONDS=60
