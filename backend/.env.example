HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/ece198.sqlite
# Optional remote Turso (libSQL) database for persistent hosted storage.
# When set, the backend connects to Turso instead of the local SQLite file:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Email bot (all optional). The address patients email, shown on their Messages tab:
# BOT_EMAIL_ADDRESS=ask@motiontrack.example.org
# Turns on POST /api/bot/inbound-email; use at least 16 random characters
# (openssl rand -hex 24 gives a value that is safe in a URL). Send it as the
# X-Bot-Secret header, as "Authorization: Bearer <secret>" (CloudMailin), or,
# when the mail service will not keep a header, on the target URL as
# /api/bot/inbound-email?secret=<secret>. A header wins over the URL. Prefer a
# header: URLs (and so the secret) can show up in proxy and tunnel logs.
# BOT_WEBHOOK_SECRET=
# Read a mailbox over IMAP instead (only when host, user and password are all set):
# BOT_IMAP_HOST=imap.example.org
# BOT_IMAP_PORT=993
# BOT_IMAP_TLS=true
# BOT_IMAP_USER=ask@motiontrack.example.org
# BOT_IMAP_PASS=
# BOT_IMAP_MAILBOX=INBOX
# BOT_IMAP_POLL_SECONDS=60
